{
  "name": "obsidian-inkflow",
  "version": "1.2.0",
  "description": "A fast, touch-first handwriting sidecar for Obsidian notes.",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "release": "npm run check"
  },
  "keywords": [
    "obsidian",
    "handwriting",
    "stylus",
    "ipad",
    "boox"
  ],
  "author": "Quang Nguyen Dang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quangnd159/inkflow.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "24.2.1",
    "@typescript-eslint/parser": "^8.66.0",
    "esbuild": "0.25.8",
    "eslint": "9.33.0",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "16.3.0",
    "obsidian": "^1.13.1",
    "tslib": "2.8.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vitest": "3.2.6"
  }
}
